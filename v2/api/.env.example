# Exemple de configuration de l'API (copier en .env, droits 600). Les valeurs ci-dessous sont des exemples.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://evocom:MOT_DE_PASSE@127.0.0.1:5432/evocom
# 32 caractères minimum : openssl rand -hex 48
JWT_SECRET=
STORAGE_DIR=/var/lib/evocom/storage
APP_URL=https://evocomprint.site
COOKIE_SECURE=true
TRUST_PROXY=1
MAX_UPLOAD_MB=4096
SESSION_HOURS=12
BACKUP_DIR=/var/backups/evocom
BACKUP_JOURS=14
# Copie des sauvegardes hors du serveur (rclone configuré au préalable) :
# RCLONE_DEST=b2:evocom-sauvegardes
