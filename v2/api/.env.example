# Exemple de configuration de l'API (copier en .env, droits 600). Les valeurs ci-dessous sont des exemples.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://evocom:MOT_DE_PASSE@127.0.0.1:5432/evocom
# 32 caractères minimum : openssl rand -hex 48
JWT_SECRET=
STORAGE_DIR=/var/lib/evocom/storage
APP_URL=https://evocomprint.site
COOKIE_SECURE=true
TRUST_PROXY=1
# Plafond du serveur pour un fichier envoyé ; l'administrateur peut fixer une limite plus basse dans Paramètres > Fichiers.
MAX_UPLOAD_MB=4096
# Durée de session initiale ; ensuite réglée dans Paramètres > Sécurité.
SESSION_HOURS=12
# Autorise la réinitialisation complète de la plateforme (Paramètres > Zone dangereuse). Laisser à false ;
# passer à true seulement le temps de l'opération, puis redémarrer l'API avec false.
ALLOW_SYSTEM_RESET=false
BACKUP_DIR=/var/backups/evocom
BACKUP_JOURS=14
# Copie des sauvegardes hors du serveur (rclone configuré au préalable) :
# RCLONE_DEST=b2:evocom-sauvegardes
# Assistant IA : secret de chiffrement de la clé OpenAI enregistrée (à défaut, JWT_SECRET est utilisé ;
# le changer rend la clé illisible, il faut alors la ressaisir dans Administration > Assistant IA).
# IA_CLE_CHIFFREMENT=
# IA_URL_OPENAI=https://api.openai.com/v1
