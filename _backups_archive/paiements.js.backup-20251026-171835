        p.date_approbation,
        p.photo_recu_path,
        p.created_at,
        d.numero as dossier_numero,
        d.client as nom_client,
        u.nom as approuve_par_nom
      FROM paiements p
      LEFT JOIN dossiers d ON p.dossier_id = d.id
      LEFT JOIN users u ON p.approuve_par = u.id
      WHERE p.livreur_id = $1
        AND p.created_at >= NOW() - INTERVAL '24 hours'
    `;
    
    const params = [req.user.id];
    let paramIndex = 2;

    // Filtres optionnels
    if (date_debut) {
      query += ` AND p.date_encaissement >= $${paramIndex++}`;
      params.push(date_debut);
    }

    if (date_fin) {
      query += ` AND p.date_encaissement <= $${paramIndex++}`;
      params.push(date_fin);
    }

    if (statut) {
      query += ` AND p.statut = $${paramIndex++}`;
      params.push(statut);
    }

    if (mode_paiement) {
      query += ` AND p.mode_paiement_final = $${paramIndex++}`;
      params.push(mode_paiement);
    }

    query += ` ORDER BY p.date_encaissement DESC LIMIT $${paramIndex++} OFFSET $${paramIndex++}`;
    params.push(parseInt(limit), parseInt(offset));

    const [encaissements] = await dbHelper.query(query, params);

    // Statistiques globales - Filtrées sur les dernières 24h
    const [stats] = await dbHelper.query(`
      SELECT 
        COUNT(*) as total,
        SUM(montant) as total_montant,
        SUM(CASE WHEN statut = 'encaisse_livreur' THEN montant ELSE 0 END) as en_attente_montant,
        SUM(CASE WHEN statut = 'approuve' THEN montant ELSE 0 END) as approuve_montant,
        SUM(CASE WHEN statut = 'refuse' THEN montant ELSE 0 END) as refuse_montant,
        COUNT(CASE WHEN statut = 'encaisse_livreur' THEN 1 END) as en_attente_count,
        COUNT(CASE WHEN statut = 'approuve' THEN 1 END) as approuve_count,
        COUNT(CASE WHEN statut = 'refuse' THEN 1 END) as refuse_count
      FROM paiements
      WHERE livreur_id = $1
        AND created_at >= NOW() - INTERVAL '24 hours'
    `, [req.user.id]);

    res.json({ 
      success: true,
      encaissements,
      stats: stats[0] || {},
      pagination: {
        limit: parseInt(limit),
        offset: parseInt(offset),
        total: encaissements.length
      }
    });
  } catch (error) {
    console.error('Erreur récupération encaissements:', error);
    res.status(500).json({ error: 'Erreur serveur', message: error.message });
  }
});

// ==========================================
// DOSSIERS À ENCAISSER POUR LE LIVREUR
// ==========================================
router.get('/a-encaisser', auth, async (req, res) => {
  try {
    // Vérifier que l'utilisateur est un livreur
    if (req.user.role !== 'livreur' && req.user.role !== 'admin') {
      return res.status(403).json({ error: 'Accès réservé aux livreurs' });
    }

    // Récupérer les dossiers à encaisser
    const [dossiers] = await dbHelper.query(`
      SELECT 
        d.id,
        d.numero,
        d.client,
        d.telephone_client,
        d.data_formulaire,
        d.montant_cfa,
        d.mode_paiement,
        d.mode_paiement_final,
        d.statut,
        d.statut_paiement,
        d.urgent,
        d.created_at,
        d.updated_at,
        u.nom as preparateur_nom
      FROM dossiers d
      LEFT JOIN users u ON d.preparateur_id = u.id
      LEFT JOIN paiements p ON d.id = p.dossier_id
        AND p.livreur_id = $1 
        AND p.statut IN ('encaisse_livreur', 'approuve')
      WHERE d.mode_paiement_final = 'a_la_livraison'
        AND d.statut IN ('en_livraison', 'livre', 'pret_livraison')
        AND (d.statut_paiement IS NULL OR d.statut_paiement NOT IN ('paye', 'encaisse'))
        AND p.id IS NULL
      ORDER BY d.created_at ASC
    `, [req.user.id]);

    // Statistiques
    const stats = {
      total: dossiers.length,
      montant_total: dossiers.reduce((sum, d) => sum + parseFloat(d.montant_cfa || 0), 0),
      urgents: dossiers.filter(d => d.urgent).length
    };

    res.json({
      success: true,
      dossiers,
      stats
    });
  } catch (error) {
    console.error('Erreur récupération dossiers à encaisser:', error);
    res.status(500).json({ error: 'Erreur serveur', message: error.message });
  }
});

module.exports = router;
