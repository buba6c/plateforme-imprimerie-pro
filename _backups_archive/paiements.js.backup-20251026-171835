const express = require('express');
const router = express.Router();
const dbHelper = require('../utils/dbHelper');
const { authenticateToken: auth } = require('../middleware/auth');

// ==========================================
// LISTE DES PAIEMENTS
// ==========================================
router.get('/', auth, async (req, res) => {
  try {
    const { statut, type, limit = 100, offset = 0 } = req.query;
    
    // Requête combinée : paiements existants + dossiers sans facture/paiement
    let query = `
      SELECT * FROM (
        -- Paiements existants
        SELECT 
          p.id,
          p.dossier_id::text,
          p.facture_id,
          p.user_id,
          p.livreur_id,
          p.montant,
          p.mode_paiement,
          p.mode_paiement_final,
          p.reference_paiement,
          p.notes,
          p.type,
          p.statut,
          p.date_approbation,
          p.date_encaissement,
          p.approuve_par,
          p.notes_admin,
          p.date_refus,
          p.refuse_par,
          p.raison_refus,
          p.created_at,
          p.updated_at,
          d.numero as dossier_numero,
          COALESCE(d.client, f.client_nom) as dossier_client,
          f.numero as facture_numero,
          f.client_nom as facture_client,
          u.nom as user_nom,
          l.nom as livreur_nom,
          'existing' as source_type
        FROM paiements p
        LEFT JOIN dossiers d ON p.dossier_id::text = d.id::text
        LEFT JOIN factures f ON p.facture_id = f.id
        LEFT JOIN users u ON p.user_id = u.id
        LEFT JOIN users l ON p.livreur_id = l.id
        
        UNION ALL
        
        -- Dossiers sans facture/paiement (affichés comme paiements potentiels)
        SELECT 
          NULL as id,
          d.id::text as dossier_id,
          NULL as facture_id,
          d.preparateur_id as user_id,
          NULL as livreur_id,
          d.montant_cfa as montant,
          d.mode_paiement,
          NULL as mode_paiement_final,
          NULL as reference_paiement,
          'Paiement à créer pour dossier sans facture' as commentaire,
          'dossier' as type,
          'a_creer' as statut,
          NULL as date_approbation,
          NULL as date_encaissement,
          NULL as approuve_par,
          NULL as commentaire_admin,
          NULL as date_refus,
          NULL as refuse_par,
          NULL as raison_refus,
          d.created_at,
          d.updated_at,
          d.numero as dossier_numero,
          d.client as dossier_client,
          NULL as facture_numero,
          NULL as facture_client,
          u.nom as user_nom,
          NULL as livreur_nom,
          'potential' as source_type
        FROM dossiers d
        LEFT JOIN factures f ON d.id = f.dossier_id
        LEFT JOIN paiements p ON d.id::text = p.dossier_id::text
        LEFT JOIN users u ON d.preparateur_id = u.id
        WHERE f.id IS NULL 
          AND p.id IS NULL 
          AND d.montant_cfa > 0
          AND d.statut NOT IN ('brouillon', 'annule')
      ) combined_results
      WHERE 1=1
    `;
    
    const params = [];
    let paramIndex = 1;

    // Filtres
    if (req.user.role === 'preparateur') {
      query += ` AND combined_results.user_id = $${paramIndex++}`;
      params.push(req.user.id);
    }
    
    if (statut) {
      if (statut === 'a_creer') {
        query += ` AND combined_results.statut = 'a_creer'`;
      } else {
        query += ` AND combined_results.statut = $${paramIndex++} AND combined_results.statut != 'a_creer'`;
        params.push(statut);
      }
    }
    
    if (type) {
      query += ` AND combined_results.type = $${paramIndex++}`;
      params.push(type);
    }
    
    query += ` ORDER BY combined_results.created_at DESC LIMIT $${paramIndex++} OFFSET $${paramIndex++}`;
    params.push(parseInt(limit), parseInt(offset));
    
    const [paiements] = await dbHelper.query(query, params);
    
    // Stats incluant les dossiers potentiels
    const [statsResult] = await dbHelper.query(`
      SELECT 
        COUNT(*) as total,
        SUM(CASE WHEN statut = 'approuve' THEN montant ELSE 0 END) as total_approuve,
        SUM(CASE WHEN statut = 'en_attente' THEN montant ELSE 0 END) as total_en_attente,
        SUM(CASE WHEN statut = 'refuse' THEN montant ELSE 0 END) as total_refuse,
        SUM(CASE WHEN statut = 'a_creer' THEN montant ELSE 0 END) as total_a_creer
      FROM (
        -- Paiements existants
        SELECT statut, montant FROM paiements
        ${req.user.role === 'preparateur' ? 'WHERE user_id = $1' : ''}
        
        UNION ALL
        
        -- Dossiers sans facture/paiement
        SELECT 'a_creer' as statut, d.montant_cfa as montant
        FROM dossiers d
        LEFT JOIN factures f ON d.id = f.dossier_id
        LEFT JOIN paiements p ON d.id::text = p.dossier_id::text
        WHERE f.id IS NULL 
          AND p.id IS NULL 
          AND d.montant_cfa > 0
          AND d.statut NOT IN ('brouillon', 'annule')
          ${req.user.role === 'preparateur' ? 'AND d.preparateur_id = $1' : ''}
      ) combined_stats
    `, req.user.role === 'preparateur' ? [req.user.id] : []);
    
    res.json({ 
      paiements,
      stats: statsResult[0] || {}
    });
  } catch (error) {
    console.error('Erreur GET /paiements:', error);
    res.status(500).json({ error: 'Erreur serveur' });
  }
});

// ==========================================
// APPROUVER UN PAIEMENT (admin seulement)
// ==========================================
router.post('/:id/approuver', auth, async (req, res) => {
  try {
    if (req.user.role !== 'admin') {
      return res.status(403).json({ error: 'Accès réservé aux administrateurs' });
    }
    
    const { commentaire } = req.body;
    const paiementId = req.params.id;
    
    // Récupérer le paiement
    const [paiement] = await dbHelper.query(
      'SELECT * FROM paiements WHERE id = $1',
      [paiementId]
    );
    
    if (paiement.length === 0) {
      return res.status(404).json({ error: 'Paiement non trouvé' });
    }
    
    // Approuver
    await dbHelper.query(
      `UPDATE paiements 
       SET statut = 'approuve', 
           date_approbation = NOW(), 
           approuve_par = $1,
           commentaire_admin = $2
       WHERE id = $3`,
      [req.user.id, commentaire || null, paiementId]
    );
    
    // 🎯 METTRE À JOUR LES STATUTS: Facture d'abord, puis dossier associé
    if (paiement[0].facture_id) {
      // Approuver la facture
      await dbHelper.query(
        `UPDATE factures 
         SET statut_paiement = 'paye' 
         WHERE id = $1`,
        [paiement[0].facture_id]
      );
      
      // Trouver et approuver le dossier associé à cette facture
      const [factureInfo] = await dbHelper.query(
        'SELECT dossier_id FROM factures WHERE id = $1',
        [paiement[0].facture_id]
      );
      
      if (factureInfo.rows && factureInfo.rows.length > 0 && factureInfo.rows[0].dossier_id) {
        await dbHelper.query(
          `UPDATE dossiers 
           SET statut_paiement = 'paye' 
           WHERE folder_id = $1::uuid`,
          [factureInfo.rows[0].dossier_id]
        );
        console.log(`[Paiements] Facture #${paiement[0].facture_id} et Dossier associé mis à jour → paye`);
      }
    } else if (paiement[0].dossier_id) {
      // Compatibilité: Si paiement direct sur dossier (ancien système)
      await dbHelper.query(
        `UPDATE dossiers 
         SET statut_paiement = 'paye' 
         WHERE folder_id = $1::uuid`,
        [paiement[0].dossier_id]
      );
    }
    
    res.json({ 
      message: 'Paiement approuvé avec succès',
      paiement_id: paiementId
    });
  } catch (error) {
    console.error('Erreur approbation paiement:', error);
    res.status(500).json({ error: 'Erreur serveur' });
  }
});

