// ==========================================
// ENREGISTRER UN NOUVEAU PAIEMENT
// ==========================================
router.post('/', auth, async (req, res) => {
  try {
    let {
      dossier_id,
      facture_id,
      montant,
      mode_paiement,
      reference_paiement,
      commentaire
    } = req.body;
    
    if (!montant || montant <= 0) {
      return res.status(400).json({ error: 'Montant invalide' });
    }
    
    if (!dossier_id && !facture_id) {
      return res.status(400).json({ error: 'Dossier ou facture requis' });
    }
    
    // 🎯 PRIORITÉ À FACTURE_ID: Si dossier_id fourni, chercher la facture associée
    if (dossier_id && !facture_id) {
      const [factureResult] = await dbHelper.query(
        `SELECT id FROM factures WHERE dossier_id = $1 ORDER BY created_at DESC LIMIT 1`,
        [dossier_id]
      );
      
      if (factureResult.rows && factureResult.rows.length > 0) {
        facture_id = factureResult.rows[0].id;
        console.log(`[Paiements] Facture #${facture_id} trouvée pour dossier #${dossier_id}`);
      } else {
        console.log(`[Paiements] Aucune facture trouvée pour dossier #${dossier_id}, paiement sur dossier`);
      }
    }
    
    const [result] = await dbHelper.query(
      `INSERT INTO paiements 
       (dossier_id, facture_id, user_id, montant, mode_paiement, reference_paiement, notes, statut)
       VALUES ($1, $2, $3, $4, $5, $6, $7, 'en_attente', $8)
       RETURNING id`,
      [
        dossier_id || null,
        facture_id || null,
        req.user.id,
        montant,
        mode_paiement || 'especes',
        reference_paiement || null,
        commentaire || null,
        facture_id ? 'facture' : 'dossier' // Type basé sur la présence de facture_id
      ]
    );
    
    const insertId = dbHelper.getInsertId(result);
    
    res.status(201).json({ 
      message: 'Paiement enregistré',
      paiement_id: insertId,
      facture_id: facture_id || null, // Retourner l'ID de facture pour info
      type: facture_id ? 'facture' : 'dossier'
    });
  } catch (error) {
    console.error('Erreur création paiement:', error);
    res.status(500).json({ error: 'Erreur serveur' });
  }
});

