// ==========================================
// CRÉER PAIEMENTS POUR DOSSIERS SANS DEVIS
// ==========================================
router.post('/auto-create-for-dossiers', auth, async (req, res) => {
  try {
    if (req.user.role !== 'admin') {
      return res.status(403).json({ error: 'Accès réservé aux administrateurs' });
    }

    // Trouver tous les dossiers qui n'ont ni facture ni paiement
    const [dossiersWithoutPaiement] = await dbHelper.query(`
      SELECT d.id, d.numero, d.client, d.montant_cfa, d.mode_paiement, d.statut
      FROM dossiers d
      LEFT JOIN factures f ON d.id = f.dossier_id
      LEFT JOIN paiements p ON d.id::text = p.dossier_id::text
      WHERE f.id IS NULL 
        AND p.id IS NULL 
        AND d.montant_cfa > 0
        AND d.statut NOT IN ('brouillon', 'annule')
      ORDER BY d.created_at DESC
    `);

    if (dossiersWithoutPaiement.length === 0) {
      return res.json({ 
        message: 'Aucun dossier sans paiement trouvé',
        created: 0,
        dossiers: []
      });
    }

    const createdPaiements = [];
    let errorCount = 0;

    for (const dossier of dossiersWithoutPaiement) {
      try {
        const [result] = await dbHelper.query(
          `INSERT INTO paiements 
           (dossier_id, user_id, montant, mode_paiement, reference_paiement, notes, statut)
           VALUES ($1, $2, $3, $4, $5, $6, 'en_attente')
           RETURNING id`,
          [
            dossier.id,
            req.user.id,
            dossier.montant_cfa,
            dossier.mode_paiement || 'especes',
            `PAY-DOS-${dossier.numero}`,
            `Paiement créé automatiquement pour dossier sans devis - ${dossier.client}`
          ]
        );

        const insertId = dbHelper.getInsertId(result);
        createdPaiements.push({
          dossier_id: dossier.id,
          dossier_numero: dossier.numero,
          client: dossier.client,
          montant: dossier.montant_cfa,
          paiement_id: insertId
        });

        console.log(`✅ Paiement automatique créé pour dossier #${dossier.id} (${dossier.numero})`);
      } catch (error) {
        console.error(`❌ Erreur création paiement pour dossier #${dossier.id}:`, error.message);
        errorCount++;
      }
    }

    res.json({
      message: `${createdPaiements.length} paiements créés avec succès`,
      created: createdPaiements.length,
      errors: errorCount,
      dossiers: createdPaiements
    });

  } catch (error) {
    console.error('Erreur création paiements auto:', error);
    res.status(500).json({ error: 'Erreur serveur' });
  }
});

// ==========================================
// CRÉER UN PAIEMENT POUR UN DOSSIER SPÉCIFIQUE
// ==========================================
router.post('/create-from-dossier/:dossier_id', auth, async (req, res) => {
  try {
    const dossierId = req.params.dossier_id;
    const { mode_paiement, commentaire } = req.body;

    // Vérifier que le dossier existe et n'a pas déjà de paiement
    const [dossier] = await dbHelper.query(
      'SELECT * FROM dossiers WHERE id = $1',
      [dossierId]
    );

    if (dossier.length === 0) {
      return res.status(404).json({ error: 'Dossier non trouvé' });
    }

    const dossierData = dossier[0];

    // Vérifier qu'il n'y a pas déjà un paiement pour ce dossier
    const [existingPaiement] = await dbHelper.query(
      'SELECT id FROM paiements WHERE dossier_id::text = (SELECT folder_id::text FROM dossiers WHERE id = $1)',
      [dossierId]
    );

    if (existingPaiement.length > 0) {
      return res.status(400).json({ error: 'Un paiement existe déjà pour ce dossier' });
    }

    // Créer le paiement
    const [result] = await dbHelper.query(
      `INSERT INTO paiements 
       (dossier_id, user_id, montant, mode_paiement, reference_paiement, notes, statut)
       VALUES ((SELECT folder_id FROM dossiers WHERE id = $1), $2, $3, $4, $5, $6, 'en_attente')
       RETURNING id`,
      [
        dossierId,
        req.user.id,
        dossierData.montant_cfa,
        mode_paiement || dossierData.mode_paiement || 'especes',
        `PAY-DOS-${dossierData.numero}`,
        commentaire || `Paiement créé pour dossier ${dossierData.numero} - ${dossierData.client}`
      ]
    );

    const insertId = dbHelper.getInsertId(result);

    res.status(201).json({
      message: 'Paiement créé avec succès',
      paiement_id: insertId,
      dossier_numero: dossierData.numero,
      client: dossierData.client,
      montant: dossierData.montant_cfa
    });

  } catch (error) {
    console.error('Erreur création paiement depuis dossier:', error);
    res.status(500).json({ error: 'Erreur serveur' });
  }
});

// ==========================================
// ENCAISSER UN PAIEMENT À LA LIVRAISON (livreur)
// ==========================================
router.post('/encaisser-livraison', auth, async (req, res) => {
  try {
    // Vérifier que l'utilisateur est un livreur
    if (req.user.role !== 'livreur' && req.user.role !== 'admin') {
      return res.status(403).json({ error: 'Accès réservé aux livreurs' });
    }

    const {
      dossier_id,
      montant,
      mode_paiement_final,
      reference_paiement,
      commentaire
    } = req.body;

    // Validation des données
    if (!dossier_id) {
      return res.status(400).json({ error: 'ID du dossier requis' });
    }

    if (!montant || montant <= 0) {
      return res.status(400).json({ error: 'Montant invalide' });
    }

    if (!mode_paiement_final) {
      return res.status(400).json({ error: 'Mode de paiement requis' });
    }

    // Vérifier que le dossier existe et est en livraison
    const [dossier] = await dbHelper.query(
      'SELECT * FROM dossiers WHERE id = $1',
      [dossier_id]
    );

    if (dossier.length === 0) {
      return res.status(404).json({ error: 'Dossier non trouvé' });
    }

    const dossierData = dossier[0];

    // Vérifier le statut du dossier
    const allowedStatuses = ['en_livraison', 'livre', 'pret_livraison'];
    if (!allowedStatuses.includes(dossierData.statut)) {
      return res.status(400).json({ 
        error: `Le dossier doit être en livraison (statut actuel: ${dossierData.statut})` 
      });
    }

    // Vérifier qu'il n'y a pas déjà un paiement encaissé pour ce dossier
    const [existingPaiement] = await dbHelper.query(
      'SELECT id FROM paiements WHERE dossier_id = $1 AND statut IN (\'encaisse_livreur\', \'approuve\')',
      [dossierData.id]
    );

    if (existingPaiement.length > 0) {
      return res.status(400).json({ error: 'Un paiement a déjà été encaissé pour ce dossier' });
    }

    // Créer le paiement
    const [result] = await dbHelper.query(
      `INSERT INTO paiements 
       (dossier_id, user_id, livreur_id, montant, mode_paiement, mode_paiement_final, 
        reference_paiement, notes, statut, date_encaissement)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8, 'encaisse_livreur', NOW())
       RETURNING id`,
      [
        dossierData.id,
        req.user.id, // user_id = livreur
        req.user.id, // livreur_id
        montant,
        dossierData.mode_paiement || 'especes',
        mode_paiement_final,
        reference_paiement || null,
        commentaire || `Encaissement à la livraison par ${req.user.nom || req.user.email}`
      ]
    );

    const insertId = dbHelper.getInsertId(result);

    // Mettre à jour le statut de paiement du dossier (en attente d'approbation)
    await dbHelper.query(
      `UPDATE dossiers 
       SET statut_paiement = 'encaisse', 
           mode_paiement_final = $1,
           updated_at = NOW()
       WHERE id = $2`,
      [mode_paiement_final, dossier_id]
    );

    console.log(`✅ Paiement encaissé par livreur #${req.user.id} pour dossier #${dossier_id}`);

    res.status(201).json({ 
      message: 'Encaissement enregistré avec succès. En attente de validation.',
      paiement_id: insertId,
      dossier_numero: dossierData.numero,
      montant: montant,
      mode_paiement: mode_paiement_final
    });
  } catch (error) {
    console.error('Erreur encaissement livraison:', error);
    res.status(500).json({ error: 'Erreur serveur', message: error.message });
  }
});

